# =========================================================================== #
# Rock in Rio 2026 – WhatsApp Festival Concierge                               #
# Copy to `.env` and fill in. All Google resources belong to                   #
# guilherme.dantas.sp@gmail.com.                                               #
# =========================================================================== #

# ---- General -------------------------------------------------------------- #
APP_ENV=prod
LOG_LEVEL=INFO
APP_PORT=8000
# Public HTTPS base URL where this service is reachable (used to build the
# /checkin link that is texted to the Galaxy S26 browser). No trailing slash.
PUBLIC_BASE_URL=https://concierge.your-domain.com

FESTIVAL_TIMEZONE=America/Sao_Paulo
FESTIVAL_START_DATE=2026-09-11
FESTIVAL_END_DATE=2026-09-13
ALERT_LEAD_MINUTES=30
RESCHEDULE_DELTA_MINUTES=15
SCHEDULER_POLL_SECONDS=60
WALKING_SPEED_KMH=4.5

# ---- Owner identity ----------------------------------------------------- #
OWNER_EMAIL=guilherme.dantas.sp@gmail.com
TARGET_CALENDAR_ID=guilherme.dantas.sp@gmail.com

# ---- Google Calendar -------------------------------------------------- #
# "service_account" (recommended for headless) or "oauth".
GOOGLE_AUTH_MODE=service_account

# service_account mode: path INSIDE the container (see docker-compose volume).
# Create the key in GCP for a project owned by guilherme.dantas.sp@gmail.com,
# then SHARE the primary calendar with the service account email as
# "Make changes to events".
GOOGLE_SERVICE_ACCOUNT_FILE=/secrets/service_account.json
# Only set if you configured Workspace domain-wide delegation; otherwise leave
# blank and rely on calendar sharing.
GOOGLE_DELEGATED_SUBJECT=

# oauth mode: run `python scripts/google_oauth_bootstrap.py` once, logged in as
# guilherme.dantas.sp@gmail.com, to produce the token file.
GOOGLE_OAUTH_CLIENT_FILE=/secrets/oauth_client.json
GOOGLE_OAUTH_TOKEN_FILE=/secrets/oauth_token.json

# Case-insensitive substring that marks a calendar event as an in-scope show.
FESTIVAL_EVENT_KEYWORD=rock in rio

# ---- Google Maps ---------------------------------------------------- #
# Distance Matrix API enabled key from the same GCP project.
GOOGLE_MAPS_API_KEY=
MAPS_TIMEOUT_SECONDS=6.0

# ---- WhatsApp ----------------------------------------------------- #
# "meta" (WhatsApp Cloud API) or "evolution" (self-hosted WhatsApp Web).
WHATSAPP_PROVIDER=meta
# Destination chat/group.
#   meta:      recipient phone in E.164 without "+" (e.g. 5521999998888)
#   evolution: group JID (e.g. 120363000000000000@g.us)
WHATSAPP_GROUP_ID=
# Arbitrary string; must match the token entered in the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string

# -- Meta Cloud API (Graph API v20.0) --
META_GRAPH_VERSION=v20.0
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=

# -- Evolution API --
EVOLUTION_BASE_URL=http://evolution-api:8080
EVOLUTION_INSTANCE=rir-concierge
EVOLUTION_API_KEY=change-me-evolution-key
EVOLUTION_PORT=8080

# ---- Gemini reasoning engine (Google AI Studio) ------------------- #
# Optional. With a key, free-text group messages are classified by Gemini
# (with the keyword router as fallback). Without it, keyword routing only.
# Get a key at https://aistudio.google.com/apikey (see README "3-minute" guide).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MIN_CONFIDENCE=0.75

# ---- Redis / state ------------------------------------------------- #
# redis://... for a shared store (multi-instance). Leave EMPTY to use the
# in-process store — correct for Cloud Run with --min/--max-instances=1.
REDIS_URL=redis://redis:6379/0
STATE_TTL_SECONDS=21600
